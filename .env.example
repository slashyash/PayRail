# Copy to .env and change every value marked CHANGE. Never commit .env.
# All gateway/bank behaviour is simulated: no real credentials belong here.

# --- PostgreSQL administrator (used only by docker compose and db/*.sh) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-local-admin-password
POSTGRES_DB=payrail
# host port for the database (5432 may clash with a locally installed PostgreSQL)
PGPORT=5432

# --- application login role (least privilege; see db/schema/99_privileges.sql) ---
APP_DB_PASSWORD=CHANGE-local-app-password

# --- backend (Task 3): cd backend && npm ci && npm start ---
# The backend connects as payrail_app, never as the administrator; the password
# here must equal APP_DB_PASSWORD above.
DATABASE_URL=postgres://payrail_app:CHANGE-local-app-password@localhost:5432/payrail
# HS256 signing key for login tokens (>= 32 chars): openssl rand -hex 32
JWT_SECRET=CHANGE-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=8h
# shared secret the simulated gateway uses to sign callbacks (>= 32 chars, local demo only)
GATEWAY_WEBHOOK_SECRET=CHANGE-generate-with-openssl-rand-hex-32
# 1 = enable POST /api/mock-gateway/... (the in-process gateway simulator for the demo)
MOCK_GATEWAY_ENABLED=1
BACKEND_PORT=4000

# --- demo / reconciliation (DEC-009, DEC-015) ---
# explicit as-of date for reconciliation and aging in the demo (Asia/Kolkata)
PAYRAIL_DEMO_AS_OF=2026-10-31
